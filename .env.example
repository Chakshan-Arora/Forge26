# Policy Intel Environment Configuration Template

# Environment Mode (development / production)
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Database Configuration
# Local SQLite default (zero setup needed):
DATABASE_URL=sqlite:///./policy_intel.db

# Production Hosted PostgreSQL (e.g. AWS RDS / Supabase / Neon / Render Postgres):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/policy_intel

# CORS Allowed Origins (comma-separated or wildcard for dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional LLM API Keys (for extended semantic reasoning)
GEMINI_API_KEY=
OPENAI_API_KEY=
